{
  "name": "survey3",
  "version": "0.0.1",
  "description": "Fragebogenapp für Wissenschaftler",
  "productName": "surveyBEST",
  "author": "ste <ste>",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "build_app": "quasar build --mode electron",
    "icons": "icongenie generate -i ./public/icons/surveyBest_icon1024.png",
    "upload": "sh upload_to_server.sh",
    "lint": "eslint --ext .js,.vue ./",
    "format": "prettier --write \"**/*.{js,vue,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit": "jest --updateSnapshot",
    "test:unit:ci": "jest --ci",
    "test:unit:coverage": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "test:unit:watchAll": "jest --watchAll"
  },
  "dependencies": {
    "@quasar/extras": "^1.0.0",
    "axios": "^0.21.1",
    "crypto-js": "^4.1.1",
    "dateformat": "^5.0.3",
    "jsencrypt": "^3.5.4",
    "jsrsasign": "^10.6.1",
    "quasar": "^2.6.0",
    "showdown": "^2.1.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0",
    "vuex": "^4.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.13.14",
    "@quasar/app-vite": "^2.0.0",
    "@vue/test-utils": "^2.2.0",
    "electron-packager": "^15.2.0",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-jest": "^27.1.3",
    "eslint-plugin-vue": "^9.0.0",
    "jest": "^29.2.2",
    "postcss": "^8.4.14",
    "prettier": "^2.5.1",
    "workbox-build": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "engines": {
    "node": ">= 16",
    "npm": ">= 8"
  }
}
