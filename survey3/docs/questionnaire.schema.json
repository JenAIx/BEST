{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://surveybest.de/schema/questionnaire.schema.json",
  "title": "surveyBEST Fragebogen",
  "description": "Kanonisches Schema eines gebündelten Fragebogens (src/assets/questionnaires/quest_*.json). Maschinen-lesbare Single Source of Truth; die Laufzeit-Prüfung lebt in src/tools/questman/validate.js (validateQuestScoring) und der Schema-Guard test/jest/__tests__/questman_scoring_schema.test.js validiert ALLE Bögen.",
  "type": "object",
  "required": ["title", "short_title", "items"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "short_title": {
      "type": "string",
      "minLength": 1,
      "description": "Eindeutiger Schlüssel des Bogens (über die gesamte Sammlung). Wird in Presets/URLs referenziert."
    },
    "description": { "type": "string" },
    "keywords": { "type": "string", "description": "Komma-separierte Suchbegriffe." },
    "manual": { "type": "string", "description": "Optionaler Hinweistext (HTML erlaubt)." },
    "coding": {
      "$ref": "#/$defs/coding",
      "description": "Empfohlen. Ausnahmen ohne coding sind zulässig (z. B. IPAQ_short, PEM_Screening)."
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" }, "minItems": 1 },
    "results": { "$ref": "#/$defs/results" }
  },
  "$defs": {
    "coding": {
      "type": "object",
      "required": ["system", "code"],
      "properties": {
        "system": { "type": "string", "enum": ["http://snomed.info/sct", "LOINC", "CUSTOM", "LEC-SEQ"] },
        "code": { "type": ["string", "number"] },
        "display": { "type": "string" },
        "version": { "type": "string", "description": "Empfohlen (z. B. Datum), aktuell nur Warnung wenn fehlt." }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["label", "type"],
      "additionalProperties": true,
      "properties": {
        "label": { "type": "string", "description": "HTML erlaubt. Bei separator/textbox die anzuzeigende Überschrift/Info." },
        "type": {
          "type": "string",
          "enum": ["radio", "checkbox", "text", "number", "date", "date_year", "time", "slider", "multiple_radio", "separator", "textbox", "image"],
          "description": "Deckt sich mit ITEM_TYPES in validate.js und den Renderern in QuestItemField.vue."
        },
        "id": {
          "description": "Numerische Item-id (oder Array). Referenziert von results.scoring/domaine. Nicht für separator/textbox.",
          "type": ["number", "string", "array"]
        },
        "tag": { "type": "string", "description": "Kategorie/Gruppen-Kürzel (frei)." },
        "value": { "description": "Antwortwert; Form je Typ (siehe docs/DATA_MODEL_ITEMS.md)." },
        "force": {
          "type": "boolean",
          "description": "Pflichtfeld-Schalter. WEGGELASSEN ⇒ Pflicht (Default required). Nur force:false macht ein Feld optional. Nicht-interaktive Typen (separator/textbox/image) sind nie Pflicht."
        },
        "inline": { "type": "boolean", "description": "Layout: radio/checkbox horizontal statt vertikal." },
        "rotate": { "type": "boolean", "description": "Layout (multiple_radio): lange Spaltenlabels schräg stellen." },
        "vertical": { "type": "boolean", "description": "Layout (slider): vertikale Ausrichtung." },
        "width": { "type": "number", "description": "Layout (image): Anzeigebreite in px." },
        "hint": { "type": "string", "description": "Platzhalter/Hinweis (text/number)." },
        "caption": { "type": "string" },
        "min": { "type": "number", "description": "number: untere Grenze (<= max)." },
        "max": { "type": "number", "description": "number: obere Grenze (>= min)." },
        "ignore_for_result": { "type": "boolean" },
        "example_value": { "description": "Nur Vorschau (QuestManager). Wird im echten Ausfüll-Flow NICHT angezeigt." },
        "coding": { "$ref": "#/$defs/coding" },
        "options": {
          "description": "radio/checkbox: Array von {label,value}. multiple_radio: {questions:[...], answers:[...]}.",
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/option" } },
            { "$ref": "#/$defs/matrixOptions" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["radio", "checkbox"] } } },
          "then": { "required": ["options"], "properties": { "options": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "properties": { "type": { "const": "multiple_radio" } } },
          "then": { "required": ["options"], "properties": { "options": { "$ref": "#/$defs/matrixOptions" } } }
        }
      ]
    },
    "option": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "description": "Numerisch für bepunktete Items (NICHT string-numerisch wie \"3\")." },
        "coding": { "$ref": "#/$defs/coding" }
      },
      "additionalProperties": true
    },
    "matrixOptions": {
      "type": "object",
      "required": ["questions", "answers"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "type": "string" },
              "tag": { "type": "string" },
              "id": { "type": ["number", "string"], "description": "Empfohlen — ermöglicht Sub-Scoring. Fehlt ⇒ Warnung MR_QUESTION_NO_ID." },
              "coding": { "$ref": "#/$defs/coding" }
            },
            "additionalProperties": true
          }
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/option" }
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "object",
      "description": "Optional (unbepunktete Bögen lassen results weg oder leer). Empfohlene Key-Reihenfolge: method, coding, evaluation, scoring, domaine.",
      "properties": {
        "method": { "type": "string", "enum": ["sum", "avg", "count", "count_targets", "ids", "nothing"] },
        "coding": { "$ref": "#/$defs/coding" },
        "evaluation": { "description": "Bereichs-Bewertung (range → label/coding)." },
        "scoring": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "array" },
              "value": { "type": "array" },
              "score": { "type": "array" },
              "method": { "type": "string", "enum": ["raw", "multiply", "range", "count"] },
              "coding": { "$ref": "#/$defs/coding" }
            },
            "additionalProperties": true
          }
        },
        "domaine": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "id": { "type": "array" },
              "method": { "type": "string", "enum": ["sum", "avg", "multiply", "sum_range", "diff_range", "sum_multiply", "avg_multiply", "sum_sub_multiply"] },
              "internal": { "type": "boolean" },
              "coding": { "$ref": "#/$defs/coding" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
